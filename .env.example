# Copy to `.env.local` and fill in. `.env.local` is gitignored; this file is not.
#
# Both values are safe to ship in the bundle -- see the note in .env.local.
# The project ref is public (it is the hostname). The publishable key grants
# nothing by itself; RLS and the function grants in supabase/migrations/ are
# what actually decide anything.
EXPO_PUBLIC_SUPABASE_URL=${EXPO_PUBLIC_SUPABASE_URL:-https://YOUR_PROJECT_REF.supabase.co}
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=${EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY:-sb_publishable_REPLACE_ME}
