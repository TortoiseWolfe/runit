node_modules/
.expo/
dist/
web-build/
*.log
.DS_Store
.env*.local
.export-check/
expo-env.d.ts

# Fidelity harness output. renders/ IS committed (it is the reference);
# screenshots/ is regenerated app output and is not.
design/screenshots/
test-results/
playwright-report/

# pnpm writes its store beside the project; in Docker this is a volume.
.pnpm-store/

# Continuous Native Generation: android/ and ios/ are OUTPUT of `expo prebuild`,
# derived from app.json and the config plugins. Committing them means hand-edits
# there silently survive a regeneration and drift from the config that is
# supposed to be the source of truth. Regenerate with `expo prebuild --clean`.
/android
/ios
.env
.env.*
!.env.example

# App Store screenshots: regenerated on demand, and NOT part of the Lane D
# render-vs-screenshot comparison -- they are shot at a different viewport.
/design/appstore

# Transient, written and deleted by tools/verify-qr.mjs.
.qr-verify.png
