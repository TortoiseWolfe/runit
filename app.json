{
  "expo": {
    "name": "RunIt",
    "slug": "runit",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "runit",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.turtlewolfe.runit",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "infoPlist": {
        "LSApplicationQueriesSchemes": ["spotify"]
      },
      "associatedDomains": [
        "applinks:runit-app.pages.dev"
      ]
    },
    "android": {
      "package": "com.turtlewolfe.runit",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "runit-app.pages.dev",
              "pathPrefix": "/i"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A1A2E"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./src/app"
        }
      ],
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "RunIt lets you add a photo you already have to this event's shared album.",
          "cameraPermission": "RunIt uses the camera so you can scan an invitation QR and add photos to this event's shared album.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "RunIt uses the camera so you can scan an invitation QR and add photos to this event's shared album.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1A1A2E"
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "RunIt shows your contacts so you can pick who to invite. It reads only the person you choose, and never uploads your address book."
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "RunIt saves a photo from this event's album to your phone, so you still have it after the album is gone.",
          "photosPermission": false,
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#1A1A2E",
          "imageWidth": 180
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "root": "./src/app"
      },
      "eas": {
        "projectId": "dfd69389-363f-47c7-af25-f7b70c294302"
      }
    },
    "owner": "turtlewolfe"
  }
}
