{
  "name": "runit",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.33.0",
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo run:android",
    "audit:keyboard": "node tools/audit-keyboard.mjs",
    "audit:styles": "node tools/audit-native-styles.mjs",
    "audit:targets": "node tools/audit-touch-targets.mjs",
    "audit:tiers": "node tools/audit-tier-claims.mjs",
    "audit:brand": "node tools/audit-brand-casing.mjs",
    "checks": "./docker/run-checks.sh",
    "checks:docker": "docker compose run --rm checks",
    "checks:shell": "docker compose run --rm shell",
    "export:web": "EXPO_PUBLIC_FIDELITY=1 expo export --platform web --output-dir dist --clear",
    "feedback:sync": "node tools/feedback-to-issues.mjs",
    "testers": "node tools/testflight-testers.mjs",
    "ios": "expo run:ios",
    "render:canvas": "node tools/render-canvas.mjs",
    "serve:dist": "node tools/serve-dist.mjs",
    "shots": "node tools/shoot-app.mjs",
    "export:web:live": "EXPO_PUBLIC_FIDELITY=1 EXPO_PUBLIC_BACKEND=supabase expo export --platform web --output-dir dist-live --clear",
    "smoke:live": "node tools/smoke-live.mjs",
    "shots:appstore": "EXPO_PUBLIC_FIDELITY=1 EXPO_PUBLIC_FIDELITY_FRAME=414x896x44x34 expo export --platform web --output-dir dist --clear && SHOT_PRESET=appstore node tools/shoot-app.mjs",
    "start": "expo start",
    "start:go": "expo start --go",
    "test": "jest",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "verify:links": "node tools/verify-links.mjs",
    "verify:policies": "node tools/verify-policies.mjs",
    "audit:sql": "node tools/audit-sql-declare.mjs",
    "schema:fingerprint": "node tools/schema-fingerprint.mjs",
    "schema:check": "node tools/schema-fingerprint.mjs --check",
    "verify:qr": "node tools/verify-qr.mjs",
    "icons": "node tools/make-icons.mjs",
    "qr:poster": "node tools/make-qr-poster.mjs",
    "scan:device": "node tools/scan-on-device.mjs",
    "web": "expo start --web"
  },
  "dependencies": {
    "@react-native-community/datetimepicker": "9.1.0",
    "@supabase/supabase-js": "^2.115.0",
    "expo": "~57.0.20",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.17",
    "expo-contacts": "~57.0.4",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.18",
    "expo-file-system": "~57.0.6",
    "expo-image-manipulator": "~57.0.16",
    "expo-image-picker": "~57.0.16",
    "expo-linking": "~57.0.9",
    "expo-media-library": "~57.0.4",
    "expo-notifications": "~57.0.17",
    "expo-router": "~57.0.19",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-qrcode-svg": "^6.3.22",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.18",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "jest": "^30.5.1",
    "jest-expo": "^57.0.5",
    "jsqr": "^1.4.0",
    "pg": "^8.23.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.6",
    "test-renderer": "^1.2.0",
    "typescript": "^5.9.3"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!(?:.pnpm/)?((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg))"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/tests/e2e/",
      "<rootDir>/node_modules/",
      "<rootDir>/dist/"
    ]
  },
  "pnpm": {
    "overrides": {
      "minimatch@3>brace-expansion": "^1.1.12"
    }
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript",
        "jest",
        "@types/jest"
      ]
    }
  }
}
